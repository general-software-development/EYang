{
  "name": "eyang",
  "version": "1.0.0",
  "description": "An open-source, lightweight extension that allows using DuckDuckGo-like bangs anywhere, with unique URLs",
  "homepage": "https://github.com/general-software-development/EYang#readme",
  "bugs": {
    "url": "https://github.com/general-software-development/EYang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/general-software-development/EYang.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "bogdan-glitchm",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs --debug",
    "build:std": "node build.mjs",
    "build:prod": "node build.mjs --production",
    "types": "tsc --noEmit",
    "bundle": "bestzip --level 9 eyang.zip ./dist && 7z a -t7z -m0=lzma2 -md=64m -mfb=273 -mhc=on -mx=9 -ms=on eyang.7z ./dist/*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "bestzip": "^4.0.3",
    "crx3": "^2.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
