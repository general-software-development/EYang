{
    "manifest_version": 3,
    "name": "Eyang URL Resolver",
    "version": "1.0.0",
    "permissions": ["tabs", "webNavigation", "storage"],
    "omnibox": {
        "keyword": "eyang"
    },
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/content.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
